{
  "name": "dlpwait",
  "version": "0.0.0",
  "description": "A wait times / entertainment schedule app for Disneyland Paris",
  "scripts": {
    "prestart": "rimraf ./build",
    "start": "webpack-dev-server --open --config webpack.config.js --mode=development",
    "prebuild": "rimraf ./build",
    "build": "cross-env NODE_ENV=production webpack --mode production --config webpack.config.js",
    "prewebpack": "rimraf ./build",
    "webpack": "webpack --watch --mode development --config webpack.config.js"
  },
  "engines": {
    "node": "^22.0.0"
  },
  "author": "Glenn de Haan",
  "license": "MIT",
  "dependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.0",
    "clsx": "^2.1.1",
    "copy-webpack-plugin": "^13.0.1",
    "cross-env": "^10.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "html-webpack-plugin": "^5.6.4",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss-loader": "^8.2.0",
    "preact": "^10.27.2",
    "preact-router": "^4.1.2",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.1.8",
    "uuid": "^13.0.0",
    "webpack": "^5.101.3",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}
